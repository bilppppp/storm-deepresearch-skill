{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generation", "release_created_at", "validation_receipt_sha256", "skill_package_sha256", "registry_metadata_sha256", "trust_report_sha256", "human_approval_sha256", "reverification_summary", "files"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "release_created_at": {"type": "string", "format": "date-time"},
    "validation_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skill_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trust_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "human_approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reverification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_source_ids", "verified_source_ids", "record_sha256"],
      "properties": {
        "required_source_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{3}$"}, "uniqueItems": true},
        "verified_source_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{3}$"}, "uniqueItems": true},
        "record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
