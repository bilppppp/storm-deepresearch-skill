{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-review-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "review_type", "author_run_id", "reviewer_run_id",
    "independent", "target_kind", "target_id", "target_sha256", "material", "verdict",
    "reason", "evidence_or_locator", "allowable_scope", "required_action",
    "acceptance_test", "findings", "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "review_id": {"type": "string", "pattern": "^REV[0-9]{3}$"},
    "review_type": {"enum": ["claim_entailment", "report_assertion"]},
    "author_run_id": {"type": "string", "minLength": 1},
    "reviewer_run_id": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "target_kind": {"enum": ["claim", "paragraph"]},
    "target_id": {"type": "string", "minLength": 1},
    "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "material": {"type": "boolean"},
    "verdict": {"enum": ["supported", "overstated", "not_supported", "unclear"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence_or_locator": {"type": "string", "minLength": 1},
    "allowable_scope": {"type": ["string", "null"]},
    "required_action": {"enum": ["none", "qualify", "remove", "rewrite", "add_evidence"]},
    "acceptance_test": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object"}},
    "reviewed_at": {"type": "string", "format": "date-time"}
  }
}
