{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-outline.schema.json",
  "title": "Evidence-Grounded Report Outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "unit", "policy", "sections"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "status": {"enum": ["planned", "complete"]},
    "unit": {"enum": ["characters", "words"]},
    "policy": {"enum": ["bounded", "open_ended"]},
    "minimum": {"type": "integer", "minimum": 1},
    "target": {"type": "integer", "minimum": 1},
    "maximum": {"type": "integer", "minimum": 1},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "title", "purpose", "target_units", "question_ids", "claim_ids", "required_elements"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^SEC[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "target_units": {"type": "integer", "minimum": 1},
          "question_ids": {"type": "array", "items": {"type": "string", "pattern": "^Q[0-9]{3}$"}, "uniqueItems": true},
          "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3}$"}, "minItems": 1, "uniqueItems": true},
          "required_elements": {
            "type": "array", "minItems": 3, "uniqueItems": true,
            "items": {"enum": ["claim", "mechanism", "evidence", "counterevidence", "example", "implication", "limitation", "change_condition"]}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"policy": {"const": "bounded"}}},
      "then": {"required": ["minimum", "target", "maximum"]}
    },
    {
      "if": {"properties": {"policy": {"const": "open_ended"}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["minimum"]},
            {"required": ["target"]},
            {"required": ["maximum"]}
          ]
        }
      }
    }
  ]
}
