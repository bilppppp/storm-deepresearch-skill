{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "questions", "source_classes", "stopping_conditions", "exclusions"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["query_id", "question", "evidence_need", "required_source_classes", "search_requirements"],
        "properties": {
          "query_id": {"type": "string", "pattern": "^Q[0-9]{3}$"},
          "question": {"type": "string", "minLength": 1},
          "evidence_need": {"type": "string", "minLength": 1},
          "required_source_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "search_requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aliases", "required_surfaces", "academic_required", "corpus_seeded",
              "inclusion_criteria", "exclusion_criteria"
            ],
            "properties": {
              "aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "required_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "academic_required": {"type": "boolean"},
              "corpus_seeded": {"type": "boolean"},
              "inclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "exclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "source_classes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["class_id", "name", "can_prove", "cannot_prove", "priority"],
        "properties": {
          "class_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "can_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cannot_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "priority": {"type": "integer", "minimum": 1}
        }
      }
    },
    "stopping_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    ,"surface_applicability": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface", "applicability", "reason"],
        "properties": {
          "surface": {"type": "string", "minLength": 1},
          "applicability": {"enum": ["required", "not_applicable"]},
          "reason": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
