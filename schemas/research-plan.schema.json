{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-plan.schema.json",
  "title": "Research Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "perspectives", "questions", "source_priorities", "stopping_conditions", "retrieval_budget", "report_outline"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "status": {"enum": ["initialized", "planned", "complete"]},
    "perspectives": {"type": "array", "items": {"type": "string"}},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "perspective", "text", "status", "claim_ids", "disposition_note"],
        "properties": {
          "question_id": {"type": "string", "pattern": "^Q[0-9]{3}$"},
          "perspective": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "answered", "unresolved", "out_of_scope"]},
          "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3}$"}, "uniqueItems": true},
          "disposition_note": {"type": "string"}
        }
      }
    },
    "source_priorities": {"type": "array", "items": {"type": "string"}},
    "stopping_conditions": {"type": "array", "items": {"type": "string"}},
    "retrieval_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_queries", "max_sources"],
      "properties": {
        "max_queries": {"type": "integer", "minimum": 1},
        "max_sources": {"type": "integer", "minimum": 1}
      }
    },
    "report_outline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unit", "minimum", "target", "maximum", "sections"],
      "properties": {
        "status": {"enum": ["initialized", "planned", "complete"]},
        "unit": {"enum": ["characters", "words"]},
        "minimum": {"type": "integer", "minimum": 1},
        "target": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1},
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "title", "purpose", "target_units", "question_ids", "claim_ids", "required_elements"],
            "properties": {
              "section_id": {"type": "string", "pattern": "^SEC[0-9]{2}$"},
              "title": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "target_units": {"type": "integer", "minimum": 1},
              "question_ids": {"type": "array", "items": {"type": "string", "pattern": "^Q[0-9]{3}$"}, "uniqueItems": true},
              "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3}$"}, "uniqueItems": true},
              "required_elements": {
                "type": "array",
                "minItems": 3,
                "uniqueItems": true,
                "items": {"enum": ["claim", "mechanism", "evidence", "counterevidence", "example", "implication", "limitation", "change_condition"]}
              }
            }
          }
        }
      }
    }
  }
}
