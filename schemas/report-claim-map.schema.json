{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-claim-map.schema.json",
  "title": "Governed Public Report Claim Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mappings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph_sha256", "paragraph_type", "claim_ids", "source_ids",
          "citation_keys", "text_locator"
        ],
        "properties": {
          "paragraph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "paragraph_type": {"enum": ["factual", "inference", "recommendation", "transition"]},
          "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3}$"}, "uniqueItems": true},
          "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{3}$"}, "uniqueItems": true},
          "citation_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "text_locator": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
