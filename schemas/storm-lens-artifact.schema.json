{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storm-lens-artifact.schema.json",
  "title": "STORM Lens Prompt Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_pack_sha256",
    "phase",
    "input_artifacts",
    "output",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "prompt_id": {"enum": ["P1", "P2", "P3", "P4"]},
    "prompt_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {"enum": ["before_retrieval", "after_findings", "after_conflicts", "after_draft"]},
    "input_artifacts": {"$ref": "#/$defs/hashMap"},
    "output": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hashMap": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
