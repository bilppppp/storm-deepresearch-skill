{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storm-lens-artifact.schema.json",
  "title": "STORM Lens Prompt Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "prompt_pack_sha256",
    "phase",
    "input_artifacts",
    "output",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "prompt_id": {"enum": ["P1", "P2", "P3", "P4"]},
    "prompt_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {"enum": ["before_retrieval", "after_findings", "after_conflicts", "after_draft"]},
    "input_artifacts": {"$ref": "#/$defs/hashMap"},
    "output": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"prompt_id": {"const": "P4"}}, "required": ["prompt_id"]},
      "then": {
        "properties": {
          "phase": {"const": "after_draft"},
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_kind", "target_sha256", "weakest_claim_ids",
              "overstated_paragraphs", "missing_perspectives",
              "citation_support_issues", "repair_actions"
            ],
            "properties": {
              "target_kind": {"const": "draft"},
              "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "weakest_claim_ids": {
                "type": "array", "uniqueItems": true,
                "items": {"type": "string", "pattern": "^C[0-9]{3}$"}
              },
              "overstated_paragraphs": {"type": "array", "items": {"type": "string"}},
              "missing_perspectives": {"type": "array", "items": {"type": "string"}},
              "citation_support_issues": {"type": "array", "items": {"type": "string"}},
              "repair_actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action_id", "target_kind", "target_id", "before_sha256",
                    "action", "disposition", "reason"
                  ],
                  "properties": {
                    "action_id": {"type": "string", "pattern": "^RA[0-9]{3}$"},
                    "target_kind": {"enum": ["draft", "paragraph", "claim"]},
                    "target_id": {"type": "string", "minLength": 1},
                    "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "action": {"type": "string", "minLength": 1},
                    "disposition": {"enum": ["required", "waived"]},
                    "reason": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hashMap": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
