{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "reviewer", "scope", "decision", "reason", "approved_artifact_sha256", "reviewed_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "approval_id": {"type": "string", "pattern": "^APP[0-9]{3}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "scope": {"enum": ["internal_high_stakes", "public_release"]},
    "decision": {"enum": ["approved", "rejected"]},
    "reason": {"type": "string", "minLength": 1},
    "approved_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
