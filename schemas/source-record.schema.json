{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-record.schema.json",
  "title": "Governed Source Register Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id", "title", "author_or_org", "canonical_url", "file_ref",
    "published_at", "publication_date_status", "retrieved_at", "source_type",
    "primary_class", "reliability_tier", "freshness_status", "reliability_notes",
    "content_hash", "bibliographic"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "author_or_org": {"type": "string", "minLength": 1},
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "file_ref": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"], "format": "date"},
    "publication_date_status": {"enum": ["known", "unknown"]},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "source_type": {"type": "string", "minLength": 1},
    "primary_class": {"enum": ["primary", "secondary"]},
    "reliability_tier": {"enum": ["A", "B", "C", "D"]},
    "freshness_status": {"enum": ["current", "stale", "historical", "unknown"]},
    "reliability_notes": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bibliographic": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifiers", "status", "version_family_id", "version_role"],
          "properties": {
            "identifiers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["doi", "pmid", "arxiv_id", "semantic_scholar_id", "openalex_id"],
              "properties": {
                "doi": {"type": ["string", "null"]},
                "pmid": {"type": ["string", "null"]},
                "arxiv_id": {"type": ["string", "null"]},
                "semantic_scholar_id": {"type": ["string", "null"]},
                "openalex_id": {"type": ["string", "null"]}
              }
            },
            "status": {"enum": ["verified", "conflicted", "unverified"]},
            "version_family_id": {"type": ["string", "null"], "pattern": "^W[0-9]{3}$"},
            "version_role": {"enum": ["preprint", "conference", "journal", "book", "chapter", "report", "other"]}
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "canonical_url": {"type": "string", "format": "uri"},
        "file_ref": {"type": "null"}
      }
    },
    {
      "properties": {
        "canonical_url": {"type": "null"},
        "file_ref": {"type": "string", "minLength": 1}
      }
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"publication_date_status": {"const": "known"}}},
      "then": {"properties": {"published_at": {"type": "string", "format": "date"}}}
    },
    {
      "if": {"properties": {"publication_date_status": {"const": "unknown"}}},
      "then": {"properties": {"published_at": {"type": "null"}}}
    }
  ]
}
