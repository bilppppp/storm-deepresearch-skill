{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief.schema.json",
  "title": "STORM DeepResearch Governed Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "topic", "research_question", "user_goal", "audience",
    "research_profile", "profile_selection", "assurance_target", "depth_level", "report_language", "length_contract", "geography", "timeframe",
    "source_policy", "freshness_policy", "retrieval_mode", "output_mode", "storm_lens_mode",
    "uncertainty_tolerance", "high_stakes", "user_materials", "assumptions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "topic": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "user_goal": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "research_profile": {
      "enum": [
        "default_full_dossier",
        "maximal_full_dossier",
        "strict_storm_lens",
        "critique_deepresearch",
        "closed_corpus",
        "briefing",
        "custom"
      ]
    },
    "profile_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selected_profile", "evidence", "available_profiles"],
      "properties": {
        "mode": {
          "enum": ["user_selected", "user_requested_default", "defaulted_after_prompt"]
        },
        "selected_profile": {
          "enum": [
            "default_full_dossier",
            "maximal_full_dossier",
            "strict_storm_lens",
            "critique_deepresearch",
            "closed_corpus",
            "briefing",
            "custom"
          ]
        },
        "evidence": {"type": "string", "minLength": 1},
        "evidence_ref": {"const": "inputs/profile-selection-evidence.txt"},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_ref": {"const": "inputs/profile-selection-prompt.txt"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "available_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "default_full_dossier",
              "maximal_full_dossier",
              "strict_storm_lens",
              "critique_deepresearch",
              "closed_corpus",
              "briefing",
              "custom"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "defaulted_after_prompt"}}},
          "then": {"required": ["prompt_ref", "prompt_sha256"]}
        },
        {
          "if": {"properties": {"mode": {"not": {"const": "defaulted_after_prompt"}}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["prompt_ref"]},
                {"required": ["prompt_sha256"]}
              ]
            }
          }
        }
      ]
    },
    "assurance_target": {
      "enum": ["artifact_contract", "captured_host_execution"]
    },
    "run_intent": {
      "enum": ["user_delivery", "diagnostic_rehearsal"]
    },
    "depth_level": {"enum": ["briefing", "standard_report", "full_dossier"]},
    "briefing_reason": {"type": "string", "minLength": 1},
    "report_language": {"type": "string", "minLength": 2},
    "length_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "policy", "content_standard"],
      "properties": {
        "unit": {"enum": ["characters", "words"]},
        "policy": {"enum": ["bounded", "open_ended"]},
        "minimum": {"type": "integer", "minimum": 1},
        "target": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1},
        "content_standard": {"const": "evidence_led"}
      },
      "allOf": [
        {
          "if": {"properties": {"policy": {"const": "bounded"}}},
          "then": {"required": ["minimum", "target", "maximum"]}
        },
        {
          "if": {"properties": {"policy": {"const": "open_ended"}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["minimum"]},
                {"required": ["target"]},
                {"required": ["maximum"]}
              ]
            }
          }
        }
      ]
    },
    "geography": {"type": "string", "minLength": 1},
    "timeframe": {"type": "string", "minLength": 1},
    "source_policy": {"enum": ["external_allowed", "closed_corpus", "primary_only"]},
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "max_age_days"],
      "properties": {
        "as_of": {"type": "string", "format": "date"},
        "max_age_days": {"type": "integer", "minimum": 0}
      }
    },
    "retrieval_mode": {"enum": ["host", "provider", "closed_corpus"]},
    "output_mode": {"enum": ["full", "reduced"]},
    "storm_lens_mode": {"enum": ["advisory", "strict"]},
    "uncertainty_tolerance": {"enum": ["low", "medium", "high"]},
    "high_stakes": {"type": "boolean"},
    "maximal_completeness_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_policy", "discovery_surface_policy",
        "surface_applicability_required", "tasklet_closure_required",
        "storm_gap_closure_required", "material_novelty_window",
        "final_integrity_required", "review_policy"
      ],
      "properties": {
        "completion_policy": {"const": "coverage_and_saturation"},
        "discovery_surface_policy": {"const": "domain_adaptive_with_mandatory_counterevidence"},
        "surface_applicability_required": {"const": true},
        "tasklet_closure_required": {"const": true},
        "storm_gap_closure_required": {"const": true},
        "material_novelty_window": {"const": 2},
        "final_integrity_required": {"const": true},
        "review_policy": {"const": "concern_driven_until_clear"}
      }
    },
    "user_materials": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"depth_level": {"const": "briefing"}}},
      "then": {"required": ["briefing_reason"]}
    },
    {
      "if": {"properties": {"depth_level": {"not": {"const": "briefing"}}}},
      "then": {"not": {"required": ["briefing_reason"]}}
    },
    {
      "if": {"properties": {"depth_level": {"const": "full_dossier"}}},
      "then": {"properties": {"output_mode": {"const": "full"}}}
    },
    {
      "if": {"properties": {"research_profile": {"const": "maximal_full_dossier"}}},
      "then": {"required": ["maximal_completeness_contract"]}
    },
    {
      "if": {"properties": {"research_profile": {"not": {"const": "maximal_full_dossier"}}}},
      "then": {"not": {"required": ["maximal_completeness_contract"]}}
    },
    {
      "if": {"properties": {"assurance_target": {"const": "captured_host_execution"}}},
      "then": {
        "properties": {
          "profile_selection": {
            "required": ["evidence_ref", "evidence_sha256"]
          }
        }
      }
    }
  ]
}
