{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governed-trust-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "skill_package_sha256", "registry_package_sha256",
    "yao_trust_report", "yao_trust_report_sha256", "skill_directory_read_only",
    "registry_read_only", "trust_report_read_only", "verified_by", "verified_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "verified"},
    "skill_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "yao_trust_report": {"type": "string", "minLength": 1},
    "yao_trust_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skill_directory_read_only": {"const": true},
    "registry_read_only": {"const": true},
    "trust_report_read_only": {"const": true},
    "verified_by": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "format": "date-time"}
  }
}
