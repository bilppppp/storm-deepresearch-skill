{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provenance_id", "review_session_id", "execution_kind",
    "author_context_id", "reviewer_context_id", "reviewer_identity", "provider",
    "model", "runner", "execution_id", "request_sha256", "review_output_sha256",
    "transcript_ref", "transcript_sha256", "started_at", "completed_at",
    "isolation_attestation", "review_sessions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "provenance_id": {"type": "string", "pattern": "^RPROV-[A-Za-z0-9._-]+$"},
    "review_session_id": {"type": "string", "minLength": 1},
    "execution_kind": {"enum": ["external_model", "human"]},
    "author_context_id": {"type": "string", "minLength": 1},
    "reviewer_context_id": {"type": "string", "minLength": 1},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "runner": {"type": ["string", "null"]},
    "execution_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transcript_ref": {"const": "artifacts/research/reviewer-transcript.txt"},
    "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "isolation_attestation": {"const": true},
    "review_sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round_id", "generation", "round_sha256", "reviewer_role", "context_id", "execution_id",
          "start_byte", "end_byte", "sha256"
        ],
        "properties": {
          "round_id": {"type": ["string", "null"], "pattern": "^RR[0-9]{3}$"},
          "generation": {"type": ["integer", "null"], "minimum": 1},
          "round_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "reviewer_role": {"type": "string", "minLength": 1},
          "context_id": {"type": "string", "minLength": 1},
          "execution_id": {"type": "string", "minLength": 1},
          "start_byte": {"type": "integer", "minimum": 0},
          "end_byte": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"execution_kind": {"const": "external_model"}}},
      "then": {"properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1}
      }}
    }
  ]
}
