<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="storm-deepresearch-skill">
  <meta name="source-sha256" content="{{ content_sha256 }}">
  <title>{{ title }}</title>
  <style>
    :root {
      --ink: #17202a; --muted: #5f6b76; --line: #d9e0e6; --paper: #ffffff;
      --wash: #f4f7f9; --accent: #165d72; --uncertain: #9a6700; --danger: #b42318;
      --measure: 72ch;
    }
    * { box-sizing: border-box; }
    html { background: var(--wash); color: var(--ink); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.68; }
    body { margin: 0; }
    .shell { display: grid; grid-template-columns: minmax(13rem, 18rem) minmax(0, var(--measure)); gap: 3rem; max-width: 1120px; margin: 0 auto; padding: 3rem 2rem 6rem; }
    nav { position: sticky; top: 2rem; align-self: start; max-height: calc(100vh - 4rem); overflow: auto; font-size: .88rem; }
    nav h2 { margin-top: 0; font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
    nav ol { margin: 0; padding-left: 1.2rem; }
    nav a { color: var(--muted); text-decoration: none; }
    nav a:hover { color: var(--accent); text-decoration: underline; }
    main { min-width: 0; background: var(--paper); padding: 3rem clamp(1.25rem, 5vw, 4rem); box-shadow: 0 12px 40px rgba(20, 38, 49, .08); }
    h1, h2, h3 { line-height: 1.25; text-wrap: balance; }
    h1 { font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.2rem, 6vw, 4rem); letter-spacing: -.035em; margin: 0 0 .35em; }
    h2 { margin: 2.6em 0 .75em; padding-top: .35em; border-top: 2px solid var(--ink); font-size: 1.45rem; }
    h3 { margin-top: 2em; }
    p, li { max-width: var(--measure); overflow-wrap: anywhere; }
    a { color: var(--accent); text-underline-offset: .18em; overflow-wrap: anywhere; }
    .footnote-back { font-family: Arial, "Segoe UI Symbol", sans-serif; }
    table { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1.25rem 0; font-size: .92rem; }
    th, td { border: 1px solid var(--line); padding: .65rem .75rem; text-align: left; vertical-align: top; }
    th { background: var(--wash); }
    pre { overflow-x: auto; padding: 1rem; background: #0f1720; color: #edf3f7; border-radius: .25rem; }
    code { font-family: "SFMono-Regular", Consolas, monospace; font-size: .9em; }
    blockquote { margin: 1.5rem 0; padding: .2rem 1rem; border-left: 4px solid var(--accent); color: var(--muted); }
    @media (max-width: 820px) { .shell { display: block; padding: 0; } nav { position: static; max-height: none; padding: 1.25rem; } main { box-shadow: none; padding: 2rem 1.25rem 4rem; } }
    @page { size: A4; margin: 18mm 16mm 20mm; @bottom-right { content: counter(page); color: #66737d; font-size: 9pt; } }
    @media print { html { background: white; } .shell { display: block; max-width: none; padding: 0; } nav, .footnote-back { display: none; } main { padding: 0; box-shadow: none; } h2 { break-after: avoid; } pre, table, blockquote { break-inside: avoid; } a { color: inherit; text-decoration: none; } }
  </style>
</head>
<body>
  <div class="shell">
    {{ toc_html | safe }}
    <main>
      {{ body_html | safe }}
    </main>
  </div>
</body>
</html>
